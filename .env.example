# Copy to .env and fill in from `terraform -chdir=infra output -raw api_gateway_id`
# and a key from `infra/seed-tenant.sh` — see the root README's "Sending logs".
OTEL_EXPORTER_OTLP_ENDPOINT=https://<api-id>.execute-api.eu-west-2.amazonaws.com/prod
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<your-api-key>
