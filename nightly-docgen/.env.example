# Copy to .env and fill in with the OTLP endpoint and API key Omnilog issued
# you for your tenant.
OTEL_EXPORTER_OTLP_ENDPOINT=https://<api-id>.execute-api.eu-west-2.amazonaws.com/prod
OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<your-api-key>

# For local runs only (src/invoke-local.mjs) — the deployed Lambda gets this
# from Terraform instead. Must be a bucket your AWS credentials can write to.
DOCUMENTS_BUCKET=<your-test-bucket>

# Optional overrides — defaults shown.
# TOTAL_DOCS=3000
# TICK_MINUTES=5
# WINDOW_START_HOUR=1
# WINDOW_END_HOUR=5
# FAILURE_RATE=0.05
