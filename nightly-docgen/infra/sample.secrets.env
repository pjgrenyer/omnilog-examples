# Template for infra/secrets.env — SAFE TO COMMIT (contains no real values).
#
# Setup:
#   cp sample.secrets.env secrets.env
# then fill in the values in secrets.env (which is gitignored — never committed).
# Every terraform command in this directory should be run after `source secrets.env`.
#
# Use a dedicated IAM user/access key scoped to this project, not personal keys
# — the same omnilog-terraform user the core omnilog-infra stack uses is fine.

unset AWS_PROFILE          # ignore any SSO profile; use the keys below

export AWS_ACCESS_KEY_ID="REPLACE_WITH_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="REPLACE_WITH_SECRET_ACCESS_KEY"

export AWS_REGION="eu-west-2"
export AWS_DEFAULT_REGION="eu-west-2"

# Feed the same keys to the Terraform provider as variables — one source of
# truth, no duplication.
export TF_VAR_aws_access_key="$AWS_ACCESS_KEY_ID"
export TF_VAR_aws_secret_key="$AWS_SECRET_ACCESS_KEY"

# The OTLP endpoint and API key Omnilog issued for your tenant — same values
# shop-demo's .env uses.
export TF_VAR_otel_exporter_otlp_endpoint="REPLACE_WITH_OTLP_ENDPOINT"
export TF_VAR_otel_exporter_otlp_headers="x-api-key=REPLACE_WITH_API_KEY"
